{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOCD-GUI",
  "version": "0.3.7",
  "identifier": "com.p4rfa1t.openocdgui",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenOCD-GUI",
        "width": 1120,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "GUI front-end for OpenOCD",
    "longDescription": "A cross-platform GUI front-end for OpenOCD: config, log, console, target control, registers, memory, flash programming, breakpoints and external GDB launch.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
